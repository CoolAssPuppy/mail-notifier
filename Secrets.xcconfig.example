// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your values.
//
// To get these values:
// - Google: https://console.cloud.google.com/apis/credentials
// - Microsoft: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade

GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET = your-google-client-secret

// Microsoft is registered as a public client (mobile/desktop), so no
// client secret is needed. PKCE secures the flow.
OUTLOOK_CLIENT_ID = your-outlook-client-id

// Polar, for Mail Notifier Pro. Not secret: these ship inside the app bundle.
// Leave empty and the app has no paywall and unlocks every account.
//
// xcconfig treats // as a comment and would truncate a URL, so write the double
// slash as $(SLASH)$(SLASH). scripts/pull-polar-secrets.sh does this for you.
SLASH = /
POLAR_ORG_ID =
POLAR_BENEFIT_ID =
POLAR_CHECKOUT_URL =
POLAR_PORTAL_URL =
POLAR_API_BASE =
